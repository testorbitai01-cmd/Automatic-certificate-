# Copy to .env (never commit .env). All secrets come from the environment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=certificates.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://certificates.example.internal

# PostgreSQL in production. If unset, a local SQLite file is used (development only).
DATABASE_URL=postgres://gradtwin:change-me@db:5432/gradtwin_certificates

# Private storage for template sources and generated certificates (not web-served).
PRIVATE_STORAGE_ROOT=/srv/gradtwin/private

# Office-authorized SMTP account (Gmail app password). Configured in Phase 7.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Master switch. Production issuance also requires an approved production template.
CERT_PRODUCTION_ISSUANCE_ENABLED=false

# Reverse proxies in front of the app that append to X-Forwarded-For (one nginx/Caddy => 1).
TRUSTED_PROXY_COUNT=1
# Public URL encoded in campaign QR codes.
PUBLIC_BASE_URL=https://certificates.example.internal
